# Port the API + dashboard listens on.
PORT=3000

# Password for the dashboard. When unset, the dashboard is open to anyone who
# can reach the port -- always set this outside local development.
ADMIN_PASSWORD=

# Secret used to encrypt gateway credentials at rest and sign session cookies.
# When unset, a random key is generated once and stored in DATA_DIR/secret.key.
# Changing it makes previously saved gateway credentials unreadable.
APP_SECRET=

# Where the SQLite database (and generated secret key) live.
DATA_DIR=./data
